import groovy.json.JsonSlurper

def BUILD_TARGET = BuildTarget()
def KEYSTORE_CREDENTIAL_ID = ""
def KEYALIAS_CREDENTIAL_ID = ""
def BUNDLE_ID = ""
def PIPELINE_NAME = ""
def SLACK_TOKEN = ""
def JOB_URL = ""
def isAndroid = "${BUILD_TARGET}" == "android"
def isIOS = "${BUILD_TARGET}" == "ios"
def isRelease = env.BRANCH_NAME.toLowerCase().contains("-release")
def isTest = env.BRANCH_NAME.toLowerCase().contains("-test")

def BuildTarget() {
    if (env.BRANCH_NAME.toLowerCase().contains("ios")) {
        return "ios"
    }
    else {
        return "android"
    }
}

def GetConfigValue(String key){
    def configData = readFile('src/Jenkins/config.cfg')
    configData = configData.split("\n")
    for(it in configData)
    {
        def lineData = it.split("=")
        if(lineData[0].trim() == key){
            return lineData[1].trim();
        }
    }
    return ""
}

// Share pipeline between Windows and OS X because they both do same thing except build code
pipeline {
    agent none
    environment {
        BUILD_CURRENT_STEP = ""
    }
    //For some case you want to build some headless server with unity linux that build/run on AWS for testing.
    //Make another parallel stages that run only on slave machine with Linux Tags.
    options {
        disableConcurrentBuilds()  //each branch has 1 job running at a time
        skipDefaultCheckout(true) // skip git default checkout because it call git clean -xffd. It clean all ignore files included cached unity /library folder. use custom git clean flags for faster build.
        buildDiscarder(logRotator(numToKeepStr: '7', artifactNumToKeepStr: '1')) // Default keep last 180 logs and latest 30 build artifacts. Will be override from Jenkins Settings website
        skipStagesAfterUnstable()
    }

    stages {
        stage('Checkout') {
            agent { label BUILD_TARGET }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Checkout']) {
                    dir('src') {
                        timeout(time: 30, unit: 'MINUTES') {
                            //Debug: you never know what is missing on slave machine
                            sh 'printenv | sort'
                            // prevent null project init on new branch
                            sh 'git init'
                            sh 'git clean -ffd'
                            sh 'git config core.ignorecase false' // For Mac unity user or you have serialized case sensitive file
                            sh 'git config --list'
                            // Jenkins git fetch and pull
                            checkout scm // the alternative to jenkins git plugin is sshagent[] and call checkout/clean by yourself
                        }
                    }

                    dir('src/Library/Bee/Android') {
                        deleteDir()
                    }

                    dir('build') {
                        deleteDir()
                    }

                    script {
                        def fileName = 'buildlog.txt'
                        if (fileExists(fileName)) {
                            echo "File '${fileName}' found, deleting..."
                            if(isUnix())
                            {
                                sh "rm -f ${fileName}"
                            }
                            else
                            {
                                bat "del /F /Q ${fileName}"
                            }
                        }

                        def channelId = ""
                        if(isRelease){
                            channelId = GetConfigValue('SLACK_RELEASE_CHANNEL_ID')
                        }
                        else {
                            channelId = GetConfigValue('SLACK_DEV_CHANNEL_ID')
                        }

                        def queuedMessage = """:loading-jump-bar: *${env.JOB_NAME.replace("%2F", "/")} #${env.BUILD_NUMBER}* - WAITING...\n<${env.BUILD_URL}|View Build>"""
                        def ts = PostSlackMessage(channelId, queuedMessage)

                        if (ts) {
                            env.SLACK_MESSAGE_TS = ts
                        } else {
                            echo "Slack notification skipped."
                        }
                    }
                }
            }
            post {
                failure {
                    script {
                        UpdateSlackMessageFailedStage()
                    }
                }
            }
        }
        stage('Prepare venv') {
            agent { label BUILD_TARGET }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Prepare Venv']) {
