import groovy.json.JsonSlurper

def BUILD_TARGET = BuildTarget()
def KEYSTORE_CREDENTIAL_ID = ""
def KEYALIAS_CREDENTIAL_ID = ""
def BUNDLE_ID = ""
def PIPELINE_NAME = ""
def SLACK_TOKEN = ""
def JOB_URL = ""
def isAndroid = "${BUILD_TARGET}" == "android"
def isIOS = "${BUILD_TARGET}" == "ios"
def isRelease = env.BRANCH_NAME.toLowerCase().contains("-release")
def isTest = env.BRANCH_NAME.toLowerCase().contains("-test")

def BuildTarget() {
    if (env.BRANCH_NAME.toLowerCase().contains("ios")) {
        return "ios"
    }
    else {
        return "android"
    }
}

def GetConfigValue(String key){
    def configData = readFile('src/Jenkins/config.cfg')
    configData = configData.split("\n")
    for(it in configData)
    {
        def lineData = it.split("=", 2)
        if(lineData.length >= 2 && lineData[0].trim() == key){
            return lineData[1].trim().replaceAll('^"|"$', '')
        }
    }
    return ""
}

// Share pipeline between Windows and OS X because they both do same thing except build code
pipeline {
    agent none
    environment {
        BUILD_CURRENT_STEP = ""
    }
    //For some case you want to build some headless server with unity linux that build/run on AWS for testing.
    //Make another parallel stages that run only on slave machine with Linux Tags.
    options {
        disableConcurrentBuilds()  //each branch has 1 job running at a time
        skipDefaultCheckout(true) // skip git default checkout because it call git clean -xffd. It clean all ignore files included cached unity /library folder. use custom git clean flags for faster build.
        buildDiscarder(logRotator(numToKeepStr: '7', artifactNumToKeepStr: '1')) // Default keep last 180 logs and latest 30 build artifacts. Will be override from Jenkins Settings website
        skipStagesAfterUnstable()
    }

    stages {
        stage('Checkout') {
            agent { label BUILD_TARGET }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Checkout']) {
                    dir('src') {
                        timeout(time: 30, unit: 'MINUTES') {
                            //Debug: you never know what is missing on slave machine
                            sh 'printenv | sort'
                            // prevent null project init on new branch
                            sh 'git init'
                            sh 'git clean -ffd'
                            sh 'git config core.ignorecase false' // For Mac unity user or you have serialized case sensitive file
                            sh 'git config --list'
                            // Jenkins git fetch and pull
                            checkout scm // the alternative to jenkins git plugin is sshagent[] and call checkout/clean by yourself
                        }
                    }

                    dir('src/Library/Bee/Android') {
                        deleteDir()
                    }

                    dir('build') {
                        deleteDir()
                    }

                    script {
                        // Resolve Slack token from Jenkins credential store.
                        // Create a "Secret text" credential with ID 'slack-bot-token' in Jenkins.
                        try {
                            withCredentials([string(credentialsId: 'slack-bot-token', variable: 'SLACK_TOKEN_FROM_CREDS')]) {
                                env.SLACK_BOT_TOKEN = SLACK_TOKEN_FROM_CREDS
                            }
                        } catch (ignored) {
                            echo "[Slack] WARNING: Jenkins credential 'slack-bot-token' not found. Slack notifications will be skipped."
                            env.SLACK_BOT_TOKEN = ""
                        }

                        def fileName = 'buildlog.txt'
                        if (fileExists(fileName)) {
                            echo "File '${fileName}' found, deleting..."
                            if(isUnix())
                            {
                                sh "rm -f ${fileName}"
                            }
                            else
                            {
                                bat "del /F /Q ${fileName}"
                            }
                        }

                        def channelId = ""
                        if(isRelease){
                            channelId = GetConfigValue('SLACK_RELEASE_CHANNEL_ID')
                        }
                        else {
                            channelId = GetConfigValue('SLACK_DEV_CHANNEL_ID')
                        }

                        def queuedMessage = """:loading-jump-bar: *${env.JOB_NAME.replace("%2F", "/")} #${env.BUILD_NUMBER}* - WAITING...\n<${env.BUILD_URL}|View Build>"""
                        def ts = PostSlackMessage(channelId, queuedMessage)

                        if (ts) {
                            env.SLACK_MESSAGE_TS = ts
                        } else {
                            echo "Slack notification skipped."
                        }
                    }
                }
            }
            post {
                failure {
                    script {
                        UpdateSlackMessageFailedStage()
                    }
                }
            }
        }
        stage('Prepare venv') {
            agent { label BUILD_TARGET }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Prepare Venv']) {
                    script {
                        sh 'printenv | sort'
                        def PYTHON_PATH

                        if (isUnix()) {
                            env.ISUNIX = "TRUE" // cache isUnix() function to prevent blueocean show too many duplicate step (Checks if running on a Unix-like node) in python function below
                            sh 'python3 -m venv pyenv'
                            PYTHON_PATH =  sh(script: 'echo ${WORKSPACE}/pyenv/bin/', returnStdout: true).trim()
                        }
                        else {
                            env.ISUNIX = "FALSE"
                            powershell(script:"py -3 -m venv pyenv") // window not allow call python3.exe with venv. https://github.com/msys2/MINGW-packages/issues/5001
                            PYTHON_PATH =  sh(script: 'echo ${WORKSPACE}/pyenv/Scripts/', returnStdout: true).trim()
                        }

                        env.PYTHON_PATH = PYTHON_PATH
                        echo "PYTHON_PATH = ${env.PYTHON_PATH}"

                        // Find unity root projects.
                        // If have multiple projects. Change */Assets to */NoSpace_Name/Assets
                        // env.UNITY_PROJECT_ROOT = sh(script: "find . -type d -path '*/Library' -prune -false -o -name 'Assets' -prune | sed -e 's/......\$//' " , returnStdout:true).trim()
                        env.UNITY_PROJECT_ROOT = sh(script: 'echo ${WORKSPACE}/src', returnStdout: true).trim()
                        echo env.UNITY_PROJECT_ROOT

                        // Sometime agent with older pip version can cause error due to non compatible plugin.
                        try  {
                            Python("-m pip install --upgrade pip")
                        }
                        catch (ignore) { } // update pip always return false when already lastest version

                        // Temporary disable because of permission error on Mac slave
                        Python("-m pip install -r $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/requirements.txt")

                        if(isTest)
                        {
                            Python("-m pip install -r $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/test-requirements.txt")
                        }
                    }
                }
            }
            post {
                failure {
                    script {
                        UpdateSlackMessageFailedStage()
                    }
                }
            }
        }
        stage('Setup Environment') {
            agent { label BUILD_TARGET }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Setup Environment']) {
                    script {
                        KEYSTORE_CREDENTIAL_ID = GetConfigValue("KEYSTORE_CREDENTIAL_ID")
                        KEYALIAS_CREDENTIAL_ID = GetConfigValue("KEYALIAS_CREDENTIAL_ID")

                        dir('src')
                        {
                            Python(" -u  $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/config_environment.py ")
                        }

                        BUNDLE_ID = GetConfigValue("BUNDLE_ID")
                        SetConfig('SLACK_MESSAGE_TS', env.SLACK_MESSAGE_TS)

                        if(isAndroid && isRelease)
                        {
                            withCredentials([file(credentialsId: "google-play-console-credentials", variable: 'GCLOUD_SERVICE_ACCOUNT_CREDENTIALS')])
                            {
                                try
                                {
                                    dir('src') {
                                        Python(" -u ${env.UNITY_PROJECT_ROOT}/Jenkins/Scripts/validate_remote_config.py")
                                    }
                                }
                                catch(err)
                                {
                                    def msg = "Validate Remote Config failed: ${err.message ?: err.toString()}"
                                    echo msg
                                    currentBuild.description = msg
                                    error(msg)
                                }
                                try
                                {
                                    // get latest app version and version code from Google Console then save into environment variables
                                    def getLatestBuildNumberCmd = "google-play get-latest-build-number --credentials=@file:$env.GCLOUD_SERVICE_ACCOUNT_CREDENTIALS --silent --tracks=internal --package-name=${BUNDLE_ID}"
                                    def latestBuildNumber = -1;

                                    if (env.ISUNIX == "TRUE") {
                                        getLatestBuildNumberCmd = "source ${WORKSPACE}/pyenv/bin/activate && ${getLatestBuildNumberCmd}"
                                        latestBuildNumber = sh (
                                            script: getLatestBuildNumberCmd,
                                            returnStdout: true
                                        ).trim()
                                    }
                                    else {
                                        getLatestBuildNumberCmd = "${WORKSPACE}\\pyenv\\Scripts\\Activate.ps1 ; ${getLatestBuildNumberCmd}"
                                        latestBuildNumber = powershell (
                                            script: getLatestBuildNumberCmd,
                                            returnStdout: true
                                        ).trim()
                                    }

                                    SetConfig("LATEST_GOOGLE_CONSOLE_VERSION_CODE", latestBuildNumber)
                                }
                                catch(err)
                                {
                                    echo err.getMessage()
                                    SetConfig("LATEST_GOOGLE_CONSOLE_VERSION_CODE", "-1")
                                }
                            }
                        }

                        def available = Python(" $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/verify_unity_installation.py")
                        if (available == 1) {
                            timeout(time: 30, unit: 'MINUTES') {
                                echo 'Start Installing Unity'
                                // TODO move this to gem U3d by dragon. UnityHub cli not working on OS X
                                error('TODO install Unity version android + macos')
                            }
                        }
                        // sh([script: "rm -R Library", returnStatus:true, label:'Clean library'])
                        // sh([script: "pkill -f java ", returnStatus:true, label:'Kill java from previous build'])
                        ExecuteHooks("after_unity_setup")
                    }
                }
            }
            post {
                failure {
                    script {
                        UpdateSlackMessageFailedStage()
                    }
                }
            }
        }
        stage('Prepare Master Files') {
            agent { label  'master'}
            steps {
                withEnv(['BUILD_CURRENT_STEP=PrepareMasterFiles']) {
                    script {
                        if(isAndroid)
                        {
                            withCredentials([usernamePassword(credentialsId: "${KEYSTORE_CREDENTIAL_ID}", usernameVariable: 'KEYSTORE_NAME', passwordVariable: 'KEYSTORE_PASSWORD')])
                            {
                                dir(env.KEYSTORE_ROOT) {
                                    echo KEYSTORE_NAME
                                    stash includes: KEYSTORE_NAME, name: 'keystore'
                                }
                            }
                        }
                    }
                }
            }
            post {
                failure {
                    script {
                        UpdateSlackMessageFailedStage()
                    }
                }
            }
        }
        stage('Build Project') {
            agent { label BUILD_TARGET }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Build Project']) {
                    script {
                        try {
                            ExecuteHooks("before_build")

                            if(isAndroid)
                            {
                                unstash 'keystore'
                            }

                            PIPELINE_NAME = GetConfigValue("PIPELINE")
                            SLACK_TOKEN = env.SLACK_BOT_TOKEN
                            JOB_URL = GetConfigValue("JOB_URL")

                            withCredentials(
                            [
                                usernamePassword(credentialsId: 'admin-jenkins-api-token', usernameVariable: 'JENKINS_API_USER', passwordVariable: 'JENKINS_API_TOKEN')]) {
                                dir('src'){
                                    println("Clean up python build monitor progress")
                                    KillPythonScript("update_build_progress.py")
                                    println("Start python build monitor progress")
                                    withEnv(['JENKINS_NODE_COOKIE=dontKillMe']){
                                        PythonBackground(" -u $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/update_build_progress.py --job-url '${env.BUILD_URL}' --build-number ${env.BUILD_NUMBER} --jenkins-user ${JENKINS_API_USER} --jenkins-token ${JENKINS_API_TOKEN} --slack-token ${SLACK_TOKEN} --pipeline-name ${PIPELINE_NAME} --interval 5")
                                    }
                                }
                            }

                            withCredentials(
                            [
                                usernamePassword(credentialsId: 'unityhub-account', usernameVariable: 'UNITY_USERNAME', passwordVariable: 'UNITY_PASSWORD'),
                                usernamePassword(credentialsId: "${KEYSTORE_CREDENTIAL_ID}", usernameVariable: 'KEYSTORE_NAME', passwordVariable: 'KEYSTORE_PASSWORD'),
                                usernamePassword(credentialsId: "${KEYALIAS_CREDENTIAL_ID}", usernameVariable: 'KEYALIAS_NAME', passwordVariable: 'KEYALIAS_PASSWORD')]) {

                                timeout(time: 100, unit: 'MINUTES') {
                                    if (isUnix()) {
                                        def shellCmd = GetConfig("UNITY_BUILD_COMMAND").trim()
                                        def unixBuildStatus = sh([script: "${shellCmd} -username ${UNITY_USERNAME} -password ${UNITY_PASSWORD} keystore-path=${WORKSPACE}/${KEYSTORE_NAME} keystore-password=${KEYSTORE_PASSWORD} keyalias-name=${KEYALIAS_NAME} keyalias-password=${KEYALIAS_PASSWORD} ", returnStatus:true, label:'Build unity on Unix'])
                                        if (unixBuildStatus != 0) {
                                            currentBuild.result = 'FAILED'
                                            error 'Build Failed by Unity. Check above log for more detail'
                                        }
                                    }
                                    else {
                                        def buildStatus = powershell([script: "$env.UNITY_PROJECT_ROOT/Jenkins/Scripts/UnityBuild.ps1 -config '$env.UNITY_PROJECT_ROOT/Jenkins/config.cfg' -quit -batchmode -silent-crashes -username ${UNITY_USERNAME} -password ${UNITY_PASSWORD} keystore-path=${WORKSPACE}/${KEYSTORE_NAME} keystore-password=${KEYSTORE_PASSWORD} keyalias-name=${KEYALIAS_NAME} keyalias-password=${KEYALIAS_PASSWORD} ", returnStatus:true, label:'Build unity on Windows'])
                                        if (buildStatus != 0) {
                                            currentBuild.result = 'FAILED'
                                            error 'Build Failed by Unity. Check above log for more detail'
                                        }
                                    }
                                }
                            }
                        } catch (err) {
                            echo "Build Project failed: ${err.getMessage()}"
                            currentBuild.result = 'FAILURE'
                            error "Fail pipeline: skipping next stages"
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "buildlog.txt , build/Android/*, build/**/*.apk, build/**/*.csv" , allowEmptyArchive: true
                }
                failure {
                    script {
                        dir('src') {
                            ExecuteHooks("after_build_failure")
                        }

                        SetConfig('BUILD_ERROR_MESSAGE', 'Unity build failed')
                        error "Unity build failed!"
                    }
                }
                aborted { // Timeout or cancel from UI blue ocean. There is issue with unity when cancel build in the middle cause library have some very troublesome files need to be removed from repo
                    script {
                        dir('src') {
                            sh([script: "git clean -ffxd", returnStatus:true, label:'Clean project after failure'])
                        }
                    }
                }
            }
        }
        // Only send test version to Test Flight.
        // Android send apk to Tester or aab to Test version
        stage('Publish') {
            agent { label BUILD_TARGET }
            environment {
                LC_ALL="en_US.UTF-8"
                LANG="en_US.UTF-8"
                //FIREBASE_CLI_TOKEN = credentials('FIREBASE_CLI_TOKEN')
            }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Publish']) {
                    script {
                        // android publisher jenkins plugin
                        if(isAndroid && isRelease)
                        {
                            // There are myriad issues when build gradle for production. Dont push production 100%
                            try {
                                androidApkUpload googleCredentialsId: 'gapu-play-console',
                                    filesPattern: '**/build/Android/*.aab',
                                    trackName: 'internal',
                                    usePreviousExpansionFilesIfMissing: true,
                                    rolloutPercentage: '100',
                                    recentChangeList: [
                                        [language: 'en-US', text: "Internal test ${env.BUILD_NUMBER}."]
                                    ]

                            } catch (err) {
                                echo err.getMessage()
                            }
                        }

                        // iOS: Build IPA with Fastlane and upload to TestFlight
                        if (isIOS) {
                            def xcode_dir = "${env.WORKSPACE}/build/iOS"
                            def fastlane_src = "${env.UNITY_PROJECT_ROOT}/Jenkins/Fastlane"

                            sh "cp -r ${fastlane_src}/fastlane ${xcode_dir}/fastlane"
                            sh "cp ${fastlane_src}/Gemfile ${xcode_dir}/Gemfile"
                            sh "cp ${fastlane_src}/Gemfile.lock ${xcode_dir}/Gemfile.lock 2>/dev/null || true"
                            sh "cp ${fastlane_src}/PodfilePostInstall.rb ${xcode_dir}/PodfilePostInstall.rb"

                            dir(xcode_dir) {
                                sh(script: "bundle install --jobs 4 --retry 3", label: "Install Fastlane gems")

                                def lane = GetConfigValue("IOS_FASTLANE_LANE") ?: "beta"

                                withCredentials([
                                    string(credentialsId: 'asc-key-id', variable: 'ASC_KEY_ID'),
                                    string(credentialsId: 'asc-issuer-id', variable: 'ASC_ISSUER_ID'),
                                    file(credentialsId: 'asc-key-file', variable: 'ASC_KEY_PATH'),
                                    string(credentialsId: 'match-password', variable: 'MATCH_PASSWORD'),
                                    string(credentialsId: 'match-git-url', variable: 'MATCH_GIT_URL'),
                                    string(credentialsId: 'ios-team-id', variable: 'IOS_TEAM_ID')
                                ]) {
                                    withEnv([
                                        "IOS_BUNDLE_ID=${BUNDLE_ID}",
                                        "MATCH_GIT_URL=${MATCH_GIT_URL}"
                                    ]) {
                                        sh(
                                            script: "bundle exec fastlane ${lane} --verbose 2>&1 | tee ${env.WORKSPACE}/fastlane_log.txt",
                                            label: "Fastlane ${lane}"
                                        )
                                    }
                                }

                                // Copy IPA to build folder for archiving and Slack upload
                                sh "cp -f *.ipa ${env.WORKSPACE}/build/iOS/ 2>/dev/null || true"
                            }
                        }

                        try {
                            Python(" -u $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/send_build_output_to_slack.py")
                        } catch (err) {
                            echo "Slack post failed: ${err.getMessage()}"
                        }
                    }
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "build/iOS/*.ipa", fingerprint: true, allowEmptyArchive: true
                    archiveArtifacts artifacts: "build/iOS/**/*.dSYM.zip", allowEmptyArchive: true
                    script {
                        ExecuteHooks("after_publish_success")
                    }
                }
                always {
                    archiveArtifacts artifacts: "fastlane_log.txt" , allowEmptyArchive: true
                }
                failure {
                    script {
                        ExecuteHooks("after_publish_failure")
                    }
                }
            }
        }
        stage('Test') {
            agent { label BUILD_TARGET }
            when {
                beforeAgent true
                allOf {
                    expression { isTest }
                    expression { isAndroid }
                }
            }
            steps {
                withEnv(['BUILD_CURRENT_STEP=Test']) {
                    script {
                        echo "Android test runner not configured. Skipping."
                    }
                }
            }
            post {
                success {
                    script {
                        ExecuteHooks("after_test_success")
                    }
                }
                failure {
                    script {
                        ExecuteHooks("after_test_failure")
                    }
                }
            }
        }
    }
    post {
        always {
            node(BUILD_TARGET) {
                script {
                    echo "==== Post final build status ===="
                    withCredentials(
                    [
                        usernamePassword(credentialsId: 'admin-jenkins-api-token', usernameVariable: 'JENKINS_API_USER', passwordVariable: 'JENKINS_API_TOKEN')]) {
                        dir('src'){
                            Python(" -u $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/update_final_slack_status.py --jenkins-user ${JENKINS_API_USER} --jenkins-token ${JENKINS_API_TOKEN}")
                        }
                    }
                }
            }
        }
        failure {
            node(BUILD_TARGET) {
                script {
                    withCredentials(
                    [
                        usernamePassword(credentialsId: 'admin-jenkins-api-token', usernameVariable: 'JENKINS_API_USER', passwordVariable: 'JENKINS_API_TOKEN')]) {
                        dir('src'){
                            Python(" -u $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/parse_and_post_errors.py --jenkins-user ${JENKINS_API_USER} --jenkins-token ${JENKINS_API_TOKEN}")
                        }
                    }
                }
            }
        }
    }
}

// Run lifecycle hook scripts registered for the given event.
// Each hook in hooks/ declares HOOK_EVENTS and HOOK_ORDER.
def ExecuteHooks(String eventName) {
    try {
        Python("-u $env.UNITY_PROJECT_ROOT/Jenkins/Scripts/run_hooks.py ${eventName}")
    } catch (err) {
        echo err.getMessage()
        unstable "Hook scripts have errors. Mark stage as unstable"
    }
}

// Legacy: kept for backward compatibility during migration. Prefer ExecuteHooks().
def ExecuteAllPythonScriptsInDirectory(String subDirectory) {
    // RunHooks.py auto-maps legacy directory names to event names
    ExecuteHooks(subDirectory)
}

// Get and Set is the same as Load .groovy into global env
// This method is more convenient since config allow communication between python and pipeline code.
// Make it easy to replicate in local without running pipeline
def GetConfig(String configKey) {
    return sh(script:". $env.UNITY_PROJECT_ROOT/Jenkins/config.cfg && echo \$${configKey}", returnStdout:true)
}

def SetConfig(String configKey, String configValue) {
    def configFilePath = ToUnixPath("$env.UNITY_PROJECT_ROOT/Jenkins/config.cfg")
    println "Jenkins Config Path: ${configFilePath}"
    sh """
    sed -i "/${configKey} =/d" ${configFilePath}
    echo '${configKey}=${configValue}'  >> ${configFilePath}
    """
}

// Several plugins like WithPyenv is not working perfectly across platform when using Virtual Env.
// Do the venv manually this way is much better.
def Python(String command) {
    def scriptsDir = "${env.UNITY_PROJECT_ROOT}/Jenkins/Scripts"
    if (env.ISUNIX == "TRUE") {
        sh script:"export PYTHONPATH=\"${scriptsDir}:\${PYTHONPATH}\" && source ${WORKSPACE}/pyenv/bin/activate && python ${command}", label: "python ${command}"
    }
    else {
        powershell script:"\$env:PYTHONPATH = '${scriptsDir}' + ';' + \$env:PYTHONPATH; \$env:PYTHONCASEOK = '1'; ${WORKSPACE}\\pyenv\\Scripts\\Activate.ps1 ; python ${command}", label: "python ${command}"
    }
}


def PythonBackground(String command) {
    // Escape ký tự % để tránh lỗi khi chạy trong shell/batch
    def escapedCommand = command.replaceAll('%', '%%')
    def scriptsDir = "${env.UNITY_PROJECT_ROOT}/Jenkins/Scripts"

    if (env.ISUNIX == "TRUE") {
        sh script: """
            echo "[INFO] === PythonBackground (Linux) ==="

            echo "[INFO] Starting new Python background task..."
            export BUILD_ID=dontKillMe
            export PYTHONPATH="${scriptsDir}:\${PYTHONPATH}"
            source ${WORKSPACE}/pyenv/bin/activate

            # Tách process khỏi Jenkins session
            nohup bash -c "setsid python -u ${escapedCommand}" > ${WORKSPACE}/python.log 2>&1 &
            disown || true

            echo "[INFO] Background Python started (detached)."
        """, label: "python ${escapedCommand}"
    } else {
        bat script: """
            echo [INFO] === PythonBackground (Windows) ===

            echo [INFO] Starting new Python background task...
            set BUILD_ID=dontKillMe
            set PYTHONPATH=${scriptsDir};%PYTHONPATH%
            set PYTHONCASEOK=1
            call ${WORKSPACE}\\pyenv\\Scripts\\activate.bat

            REM Dùng start "" cmd /C để detach hoàn toàn khỏi Jenkins
            start "" cmd /C "python -u ${escapedCommand} > ${WORKSPACE}\\python.log 2>&1"

            echo [INFO] Background Python started (detached).
        """, label: "python ${escapedCommand}"
    }
}

def KillPythonScript(String match) {
    if (env.ISUNIX == "TRUE") {
        sh """
            echo "[INFO] Killing python scripts containing: ${match}"
            pkill -f "${match}" || true
        """
    } else {
        bat """
            echo [INFO] Killing python scripts containing: ${match}
            taskkill /F /FI "IMAGENAME eq python.exe" /FI "WINDOWTITLE eq *${match}*" >nul 2>&1 || exit /b 0
        """
    }
}

def ConvertPathSeparator(String path){
    if (env.ISUNIX == "TRUE") {
        return path.replace("\\", "/")
    }
    else {
        return path.replace("/", "\\")
    }
}

def ToUnixPath(String path){
    return path.replace("\\", "/")
}

def PostSlackMessage(String channelId, String text) {
    if (!env.SLACK_BOT_TOKEN?.trim()) {
        echo "[Slack] No token configured — skipping postMessage."
        return null
    }
    def resp = sh(script: """
        curl -s -X POST \
        -H "Authorization: Bearer ${env.SLACK_BOT_TOKEN}" \
        -H 'Content-type: application/json; charset=utf-8' \
        --data '{
            "channel": "${channelId}",
            "text": "${text}"
        }' \
        https://slack.com/api/chat.postMessage
    """, returnStdout: true).trim()

    def json = new JsonSlurper().parseText(resp)

    if (json.ok) {
        echo "Slack message posted successfully (ts=${json.ts})"
        return json.ts
    } else {
        echo "Slack postMessage failed: ${json.error}"
        return null
    }
}

def UpdateSlackMessage(String channelId, String ts, String text) {
    if (!ts || !env.SLACK_BOT_TOKEN?.trim()) {
        echo "[Slack] No token or timestamp — skipping update."
        return
    }

    def resp = sh(script: """
        curl -s -X POST \
        -H "Authorization: Bearer ${env.SLACK_BOT_TOKEN}" \
        -H 'Content-type: application/json; charset=utf-8' \
        --data '{
            "channel": "${channelId}",
            "ts": "${ts}",
            "text": "${text}"
        }' \
        https://slack.com/api/chat.update
    """, returnStdout: true).trim()

    def json = new JsonSlurper().parseText(resp)

    if (json.ok) {
        echo "Slack message updated successfully (ts=${ts})"
        return true
    } else {
        echo "Slack updateMessage failed: ${json.error}"
        return false
    }
}

def DeleteSlackMessage(String channelId, String ts) {
    if (!ts || !env.SLACK_BOT_TOKEN?.trim()) {
        echo "[Slack] No token or timestamp — skipping delete."
        return
    }

    def resp = sh(script: """
        curl -s -X POST \
        -H "Authorization: Bearer ${env.SLACK_BOT_TOKEN}" \
        -H 'Content-type: application/json; charset=utf-8' \
        --data '{
            "channel": "${channelId}",
            "ts": "${ts}"
        }' \
        https://slack.com/api/chat.delete
    """, returnStdout: true).trim()

    def json = new groovy.json.JsonSlurper().parseText(resp)
    if (json.ok) {
        echo "Slack message deleted successfully (ts=${ts})"
        env.SLACK_MESSAGE_TS = ""
        return true
    } else {
        echo "Slack deleteMessage failed: ${json.error}"
        return false
    }
}

def UpdateSlackMessageFailedStage() {
    if (!env.SLACK_MESSAGE_TS?.trim() || !env.SLACK_BOT_TOKEN?.trim()) {
        echo "[Slack] No token or SLACK_MESSAGE_TS — skipping update."
        return
    }

    def stageName = env.BUILD_CURRENT_STEP ?: "Unknown Stage"
    def channelId = ""
    if (env.BRANCH_NAME?.toLowerCase()?.contains("-release")) {
        channelId = GetConfigValue('SLACK_RELEASE_CHANNEL_ID')
    } else {
        channelId = GetConfigValue('SLACK_DEV_CHANNEL_ID')
    }

    def ts = env.SLACK_MESSAGE_TS
    def token = env.SLACK_BOT_TOKEN

    def emoji = ":x:"
    def status = "FAILED at stage *${stageName}*"
    def projectName = GetConfigValue("PROJECT_NAME")
    def developer = sh(script: "git log -1 --pretty=format:%cn", returnStdout: true).trim()
    def commitHash = sh(script: "git log -1 --pretty=format:%h", returnStdout: true).trim()
    def commitMsg = sh(script: "git log -1 --pretty=format:%B", returnStdout: true).trim()
    def branch = env.BRANCH_NAME
    def buildNumber = env.BUILD_NUMBER
    def buildUrl = env.BUILD_URL

    def message = """${emoji} *${projectName} #${buildNumber}* - ${status}
Branch: `${branch}`
Developer: `${developer}`
Commit SHA: `${commitHash}`
Changelog:
```""" + commitMsg + """```
<${buildUrl}|View Build Details>"""

    // Update message lên Slack
    def resp = sh(script: """
        curl -s -X POST \
        -H "Authorization: Bearer ${token}" \
        -H 'Content-type: application/json; charset=utf-8' \
        --data '{
            "channel": "${channelId}",
            "ts": "${ts}",
            "text": "${message.replaceAll('"','\\\\\\"')}"
        }' \
        https://slack.com/api/chat.update
    """, returnStdout: true).trim()

    def json = new groovy.json.JsonSlurper().parseText(resp)
    if (json.ok) {
        echo "[Slack] Updated message with FAILED stage: ${stageName}"
    } else {
        echo "[Slack] Failed to update Slack message: ${json.error}"
    }
}
